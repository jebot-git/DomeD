+static Fl_Wayland_Pen_Event dome_pen_event(const DomePenPtr &t,int action,unsigned time,bool tip) {
+  Fl_Wayland_Pen_Event e={};e.version=1;e.action=action;e.id=t->id;e.primary=t->primary;e.tool_type=t->type;
