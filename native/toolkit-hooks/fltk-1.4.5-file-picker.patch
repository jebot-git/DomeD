+namespace {
+int natural(const std::string &a, const std::string &b) {
+  const char *x = a.c_str(), *y = b.c_str(), *xe = x + a.size(), *ye = y + b.size();
+  while (x < xe && y < ye) {
+    if (*x >= '0' && *x <= '9' && *y >= '0' && *y <= '9') {
+      const char *ax = x, *by = y;
+      while (ax < xe && *ax == '0')
+        ++ax;
+      while (by < ye && *by == '0')
+        ++by;
+      const char *endA = ax, *endB = by;
+      while (endA < xe && *endA >= '0' && *endA <= '9')
+        ++endA;
+      while (endB < ye && *endB >= '0' && *endB <= '9')
+        ++endB;
+      if (endA - ax != endB - by)
+        return endA - ax < endB - by ? -1 : 1;
+      int cmp = std::memcmp(ax, by, endA - ax);
+      if (cmp)
+        return cmp < 0 ? -1 : 1;
+      x = endA;
+      y = endB;
+    } else {
+      int na = 0, nb = 0;
+      unsigned ca = fl_tolower(fl_utf8decode(x, xe, &na));
+      unsigned cb = fl_tolower(fl_utf8decode(y, ye, &nb));
+      if (ca != cb)
+        return ca < cb ? -1 : 1;
+      x += std::max(1, na);
+      y += std::max(1, nb);
+    }
+  }
+  if (x < xe || y < ye)
+    return x < xe ? 1 : -1;
+  return a.compare(b);
+}
+struct File {
+  std::string name, type, sizeText, dateText;
+  void *icon = 0;
+  bool folder = false, parent = false, known = false;
+  unsigned long long bytes = 0;
+  time_t modified = 0;
+};
+class DetailsBrowser;
+class DetailsPanel : public Fl_Group {
+public:
+  DetailsBrowser *browser;
+  Fl_Button *headers[4];
+  DetailsPanel(int, int, int, int);
+  void layout();
+  void resize(int, int, int, int) FL_OVERRIDE;
+  void draw() FL_OVERRIDE {
+    layout();
+    Fl_Group::draw();
+  }
+};
+class DetailsToolbar : public Fl_Group {
+public:
+  Fl_Choice key, direction;
+  Fl_Check_Button folders, details;
+  Fl_Button refresh;
+  DetailsToolbar(int X, int Y, int W)
+      : Fl_Group(X, Y, W, 30), key(X + 60, Y, 140, 30, "Sort by:"), direction(X + 210, Y, 120, 30),
+        folders(X + 340, Y, 130, 30, "Folders first"), details(X + 480, Y, 90, 30, "Details"),
+        refresh(X + W - 90, Y, 90, 30, "Refresh") {
+    end();
+    key.add("Name|Size|Type|Modified");
+    direction.add("Ascending|Descending");
+    key.tooltip("Choose the file ordering; column headings also sort");
+    direction.tooltip("Reverse file ordering; parent directory stays first");
+    folders.tooltip("Keep folders before files in either direction");
+    details.tooltip("Show file size, type and last modification time");
+    refresh.shortcut(FL_F + 5);
+    refresh.tooltip("Reload this directory (F5)");
+  }
+  void resize(int X, int Y, int W, int H) FL_OVERRIDE {
+    Fl_Group::resize(X, Y, W, H);
+    key.resize(X + 60, Y, 140, 30);
+    direction.resize(X + 210, Y, 120, 30);
+    folders.resize(X + 340, Y, 130, 30);
+    details.resize(X + 480, Y, 90, 30);
+    refresh.resize(X + W - 90, Y, 90, 30);
+  }
+};
+class DetailsBrowser : public Fl_File_Browser {
+public:
+  DetailsPanel *panel;
+  DetailsToolbar *toolbar = 0;
+  Fl_File_Chooser *chooser = 0;
+  Fl_Preferences *prefs = 0;
+  int key = 0;
+  bool descending = false, foldersFirst = true, details = true;
+  std::map<std::string, File> files;
+  DetailsBrowser(int X, int Y, int W, int H, DetailsPanel *p)
+      : Fl_File_Browser(X, Y, W, H), panel(p) {
+    has_scrollbar(VERTICAL_ALWAYS);
+  }
+  void widths(int W, int out[4]) const {
+    int date = details && W >= 410 ? textsize() * 9 + 10 : 0;
+    int size = details && W >= 280 ? textsize() * 5 + 12 : 0;
+    int type = details && W >= 620 ? textsize() * 6 + 12 : 0;
+    out[0] = std::max(40, W - size - type - date);
+    out[1] = size;
+    out[2] = type;
+    out[3] = date;
+  }
+  void sortRows() {
+    std::vector<File> rows;
+    std::set<std::string> selection;
+    std::string focus = value() > 0 ? text(value()) : "";
+    for (int i = 1; i <= size(); ++i) {
+      if (selected(i))
+        selection.insert(text(i));
+      rows.push_back(files.at(text(i)));
+    }
+    std::stable_sort(rows.begin(), rows.end(), [&](const File &a, const File &b) {
+      if (a.parent != b.parent)
+        return a.parent;
+      if (foldersFirst && a.folder != b.folder)
+        return a.folder;
+      // Unavailable metadata stays last, even when ordering is reversed.
+      bool knownA = key == 1 ? a.known && !a.folder : a.known;
+      bool knownB = key == 1 ? b.known && !b.folder : b.known;
+      if ((key == 1 || key == 3) && knownA != knownB)
+        return knownA;
+      int cmp = 0;
+      if (key == 1 && knownA && knownB)
+        cmp = a.bytes < b.bytes ? -1 : a.bytes > b.bytes ? 1 : 0;
+      else if (key == 2)
+        cmp = fl_utf_strcasecmp(a.type.c_str(), b.type.c_str());
+      else if (key == 3 && knownA && knownB)
+        cmp = a.modified < b.modified ? -1 : a.modified > b.modified ? 1 : 0;
+      if (!cmp)
+        cmp = natural(a.name, b.name);
+      return descending ? cmp > 0 : cmp < 0;
+    });
+    int scroll = vposition();
+    clear();
+    int focused = 0;
+    for (const auto &f : rows) {
+      add(f.name.c_str(), f.icon);
+      if (selection.count(f.name))
+        select(size(), 1);
+      if (focus == f.name)
+        focused = size();
+    }
+    // Reordering changes neither the filename field nor the selected file set.
+    if (focused && selection.count(focus))
+      select(focused, 1);
+    vposition(scroll);
+    panel->layout();
+    panel->redraw();
+  }
+  void refresh(const char *directory) {
+    files.clear();
+    for (int i = 1; i <= size(); ++i) {
+      File f;
+      f.name = text(i);
+      f.icon = data(i);
+      f.parent = f.name == "../" || f.name == "..";
+      f.folder = !f.name.empty() && f.name[f.name.size() - 1] == '/';
+      std::string path = directory && *directory ? std::string(directory) + "/" + f.name : f.name;
+      struct stat st;
+      f.known = fl_stat(path.c_str(), &st) == 0;
+      if (f.known) {
+        f.modified = st.st_mtime;
+        f.bytes = st.st_size < 0 ? 0 : st.st_size;
+        struct tm *tm = std::localtime(&f.modified);
+        char date[40];
+        if (tm && std::strftime(date, sizeof(date), "%Y-%m-%d %H:%M", tm))
+          f.dateText = date;
+      }
+      if (f.folder)
+        f.type = "Folder";
+      else {
+        std::string::size_type dot = f.name.find_last_of('.');
+        f.type = dot != std::string::npos && dot > 0 && dot + 1 < f.name.size()
+                     ? f.name.substr(dot + 1) + " file"
+                     : "File";
+        if (f.known) {
+          char size[48];
+          if (f.bytes < 1024)
+            std::snprintf(size, sizeof(size), "%llu B", f.bytes);
+          else {
+            const char *units[] = {"KiB", "MiB", "GiB", "TiB", "PiB"};
+            double bytes = f.bytes / 1024.;
+            int unit = 0;
+            while (bytes >= 1024. && unit < 4) {
+              bytes /= 1024.;
+              ++unit;
+            }
+            std::snprintf(size, sizeof(size), "%.1f %s", bytes, units[unit]);
+          }
+          f.sizeText = size;
+        }
+      }
+      files[f.name] = f;
+    }
+    sortRows();
+  }
+  void sync() {
+    toolbar->key.value(key);
+    toolbar->direction.value(descending);
+    toolbar->folders.value(foldersFirst);
+    toolbar->details.value(details);
+    if (prefs) {
+      prefs->set("sort_key", key);
+      prefs->set("sort_descending", int(descending));
+      prefs->set("sort_folders_first", int(foldersFirst));
+      prefs->set("file_details", int(details));
+      prefs->flush();
+    }
+    sortRows();
+  }
+  static void changed(Fl_Widget *widget, void *data) {
+    DetailsBrowser &b = *static_cast<DetailsBrowser *>(data);
+    b.key = b.toolbar->key.value();
+    b.descending = b.toolbar->direction.value();
+    b.foldersFirst = b.toolbar->folders.value();
+    b.details = b.toolbar->details.value();
+    b.sync();
+  }
+  static void header(Fl_Widget *widget, void *data) {
+    DetailsBrowser &b = *static_cast<DetailsBrowser *>(data);
+    for (int i = 0; i < 4; ++i)
+      if (widget == b.panel->headers[i]) {
+        if (b.key == i)
+          b.descending = !b.descending;
+        else {
+          b.key = i;
+          b.descending = false;
+        }
+      }
+    b.sync();
+  }
+  void item_draw(void *item, int X, int Y, int W, int H) const FL_OVERRIDE {
+    int columns[4];
+    widths(W, columns);
+    fl_push_clip(X, Y, columns[0], H);
+    Fl_Color foreground =
+        item_selected(item) ? fl_contrast(textcolor(), selection_color()) : textcolor();
+    const char *name = item_text(item);
+    int offset = 4;
+    if (Fl_File_Icon::first()) {
+      Fl_File_Icon *icon = static_cast<Fl_File_Icon *>(data(lineno(item)));
+      if (icon)
+        icon->draw(X + 2, Y + (H - iconsize()) / 2, iconsize(), iconsize(),
+                   item_selected(item) ? FL_YELLOW : FL_LIGHT2, active_r());
+      offset = iconsize() + 8;
+    }
+    std::string display = name;
+    for (size_t i = 0; i < display.size(); ++i)
+      if (static_cast<unsigned char>(display[i]) < 32)
+        display[i] = ' ';
+    bool folder = !display.empty() && display[display.size() - 1] == '/';
+    fl_font(folder ? Fl_Font(textfont() | FL_BOLD) : textfont(), textsize());
+    fl_color(foreground);
+    fl_draw(display.c_str(), X + offset, Y, std::max(1, columns[0] - offset - 4), H,
+            FL_ALIGN_LEFT | FL_ALIGN_INSIDE, 0, 0);
+    fl_pop_clip();
+    std::map<std::string, File>::const_iterator found = files.find(item_text(item));
+    if (found == files.end())
+      return;
+    const File &f = found->second;
+    fl_font(textfont(), textsize());
+    fl_color(item_selected(item) ? fl_contrast(textcolor(), selection_color()) : textcolor());
+    const std::string values[] = {f.sizeText, f.type, f.dateText};
+    X += columns[0];
+    for (int i = 1; i < 4; ++i) {
+      if (columns[i]) {
+        fl_push_clip(X, Y, columns[i], H);
+        fl_draw(values[i - 1].c_str(), X + 6, Y, columns[i] - 12, H,
+                Fl_Align(FL_ALIGN_INSIDE | (i == 1 ? FL_ALIGN_RIGHT : FL_ALIGN_LEFT)), 0, 0);
+        fl_pop_clip();
+      }
+      X += columns[i];
+    }
+  }
+  int item_height(void *) const FL_OVERRIDE {
+    fl_font(textfont(), textsize());
+    return std::max(fl_height() + 4, Fl_File_Icon::first() ? int(iconsize()) + 4 : 0);
+  }
+  int item_width(void *) const FL_OVERRIDE { return 0; }
+};
+DetailsPanel::DetailsPanel(int X, int Y, int W, int H) : Fl_Group(X, Y, W, H) {
+  browser = new DetailsBrowser(X, Y + 26, W, H - 26, this);
+  const char *labels[] = {"Name", "Size", "Type", "Modified"};
+  for (int i = 0; i < 4; ++i) {
+    headers[i] = new Fl_Button(X, Y, 60, 26, labels[i]);
+    headers[i]->align(FL_ALIGN_LEFT | FL_ALIGN_INSIDE);
+    headers[i]->callback(DetailsBrowser::header, browser);
+    headers[i]->tooltip("Click to sort; click again to reverse");
+  }
+  end();
+  resizable(browser);
+  layout();
+}
+void DetailsPanel::layout() {
+  const char *labels[] = {"Name", "Size", "Type", "Modified"};
+  int widths[4];
+  browser->widths(w() - Fl::box_dw(browser->box()) - Fl::scrollbar_size(), widths);
+  int X = x() + Fl::box_dx(browser->box());
+  for (int i = 0; i < 4; ++i) {
+    if (widths[i]) {
+      headers[i]->show();
+      headers[i]->resize(X, y(), widths[i], 26);
+      std::string label = labels[i];
+      if (browser->key == i)
+        label += browser->descending ? " ↓" : " ↑";
+      if (!headers[i]->label() || label != headers[i]->label())
+        headers[i]->copy_label(label.c_str());
+    } else
+      headers[i]->hide();
+    X += widths[i];
+  }
+}
+void DetailsPanel::resize(int X, int Y, int W, int H) {
+  Fl_Group::resize(X, Y, W, H);
+  browser->resize(X, Y + 26, W, std::max(1, H - 26));
+  layout();
+}
+} // namespace
+
+Fl_File_Browser *fl_file_chooser_details_browser(Fl_File_Browser *old) {
+  Fl_Group *parent = old->parent();
+  parent->begin();
+  DetailsPanel *panel = new DetailsPanel(old->x(), old->y(), old->w(), old->h());
+  DetailsBrowser *b = panel->browser;
+  b->type(old->type());
+  b->box(old->box());
+  b->callback(old->callback(), old->user_data());
+  b->when(old->when());
+  parent->remove(old);
+  delete old;
+  Fl_Group::current(parent);
+  return b;
+}
+void fl_file_chooser_details_init(Fl_File_Browser *file, Fl_File_Chooser *chooser,
+                                  Fl_Window *window, Fl_Preferences *prefs) {
+  DetailsBrowser *b = static_cast<DetailsBrowser *>(file);
+  b->chooser = chooser;
+  b->prefs = prefs;
+  int value;
+  prefs->get("sort_key", value, 0);
+  b->key = std::max(0, std::min(3, value));
+  prefs->get("sort_descending", value, 0);
+  b->descending = value != 0;
+  prefs->get("sort_folders_first", value, 1);
+  b->foldersFirst = value != 0;
+  prefs->get("file_details", value, 1);
+  b->details = value != 0;
+  Fl_Group *tile = b->panel->parent();
+  // Keep FLUID-generated file-list callbacks valid through the details panel.
+  tile->user_data(chooser);
+  tile->resize(tile->x(), tile->y() + 36, tile->w(), tile->h() - 36);
+  window->begin();
+  b->toolbar = new DetailsToolbar(10, 45, window->w() - 20);
+  window->end();
+  b->toolbar->key.callback(DetailsBrowser::changed, b);
+  b->toolbar->direction.callback(DetailsBrowser::changed, b);
+  b->toolbar->folders.callback(DetailsBrowser::changed, b);
+  b->toolbar->details.callback(DetailsBrowser::changed, b);
+  b->toolbar->refresh.callback(
+      [](Fl_Widget *, void *data) {
+        DetailsBrowser *b = static_cast<DetailsBrowser *>(data);
+        std::set<std::string> selected;
+        for (int i = 1; i <= b->size(); ++i)
+          if (b->selected(i))
+            selected.insert(b->text(i));
+        b->chooser->rescan_keep_filename();
+        for (int i = 1; i <= b->size(); ++i)
+          if (selected.count(b->text(i)))
+            b->select(i, 1);
+      },
+      b);
+  b->toolbar->key.value(b->key);
+  b->toolbar->direction.value(b->descending);
+  b->toolbar->folders.value(b->foldersFirst);
+  b->toolbar->details.value(b->details);
+  window->init_sizes();
+  window->size_range(720, 420);
+  window->size(960, 600);
+}
+void fl_file_chooser_details_refresh(Fl_File_Browser *file, const char *directory) {
+  static_cast<DetailsBrowser *>(file)->refresh(directory);
+}
