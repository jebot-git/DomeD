+extern "C" FL_EXPORT int fl_wl_window_suspended(Fl_Window *window) {
+  if (!window || !fl_wl_display()) return -1;
+  struct wld_window *xid = fl_wl_xid(window->top_window());
+  if (!xid || xid->kind != Fl_Wayland_Window_Driver::DECORATED || !xid->frame)
+    return -1;
+#ifdef XDG_TOPLEVEL_STATE_SUSPENDED_SINCE_VERSION
+  struct xdg_toplevel *top = libdecor_frame_get_xdg_toplevel(xid->frame);
+  if (!top || wl_proxy_get_version((struct wl_proxy *)top) <
+      XDG_TOPLEVEL_STATE_SUSPENDED_SINCE_VERSION) return -1;
+  return (xid->state & LIBDECOR_WINDOW_STATE_SUSPENDED) ? 1 : 0;
+#else
+  return -1;
+#endif
+}
