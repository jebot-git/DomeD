 Fl_Cairo_Graphics_Driver::~Fl_Cairo_Graphics_Driver() {
+  // The window owns cairo_; only the dummy context belongs to this driver.
+  if (dummy_cairo_) cairo_destroy(dummy_cairo_);
+  while (clip_) {
+    Clip *previous = clip_->prev;
+    delete clip_;
+    clip_ = previous;
+  }
+  for (int i = 0; i <= rstackptr; ++i) {
+    if (rstack[i]) cairo_region_destroy((cairo_region_t*)rstack[i]);
+    rstack[i] = NULL;
+  }
 }
 
