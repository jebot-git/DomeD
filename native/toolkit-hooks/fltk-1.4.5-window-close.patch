-static void delayed_close(Fl_Window *win) {
-  Fl::remove_check((Fl_Timeout_Handler)delayed_close, win);
+static void delayed_close(void *data) {
+  Fl_Widget_Tracker *tracker = (Fl_Widget_Tracker *)data;
+  Fl_Window *win = (Fl_Window *)tracker->widget();
+  if (!win || !win->shown()) { delete tracker; return; }
+  // popup_done and close can arrive in the same Wayland dispatch. The modal
+  // menu must unwind its grab before FL_CLOSE, otherwise Fl::handle drops it.
+  if (Fl::grab() || (Fl::modal() && Fl::modal() != win)) {
+    Fl::repeat_timeout(.01, delayed_close, data);
+    return;
+  }
   Fl::handle(FL_CLOSE, win);
+  delete tracker;
+}
+
+static void request_close(Fl_Window *win) {
+  Fl_Window_Driver::dismiss_menu();
+  // Also leave libdecor's callback before a callback can destroy its frame.
+  Fl::add_timeout(0., delayed_close, new Fl_Widget_Tracker(win));
 }
 
 
