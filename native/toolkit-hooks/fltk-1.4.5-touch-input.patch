+// Optional raw touch delivery. Keep protocol contacts separate from delivered
+// contacts: down/up IDs may be reused before the next wl_touch.frame.
+namespace {
+static unsigned long long dome_touch_generation = 0;
+struct DomeTouchContact {
+  int id;
+  unsigned long long generation;
+  bool primary;
+  int mode; // 0 pending, 1 raw callback, 2 legacy UI fallback, 3 ignored
+  double x, y;
+  Fl_Wayland_Touch_Handler handler;
+  void *user;
+  Fl_Widget_Tracker source;
+  Fl_Widget_Tracker top;
+  DomeTouchContact(int id_, bool primary_, Fl_Window *source_, Fl_Window *top_,
+                   Fl_Wayland_Touch_Handler handler_, void *user_) :
+    id(id_), generation(dome_touch_generation), primary(primary_), mode(0), x(0), y(0), handler(handler_), user(user_),
+    source(source_), top(top_) {}
+  Fl_Window *window() {
+    return top.deleted() ? NULL : top.widget()->as_window();
+  }
+  bool position(wl_fixed_t sx, wl_fixed_t sy) {
+    if (source.deleted() || top.deleted()) return false;
+    Fl_Window *win = source.widget()->as_window();
+    if (!win || !win->shown() || !win->visible_r()) return false;
+    double dx = 0, dy = 0;
+    while (win->parent()) { dx += win->x(); dy += win->y(); win = win->window(); }
+    if (win != window()) return false;
+    const double scale = Fl::screen_scale(win->screen_num());
+    if (!(scale > 0) || !std::isfinite(scale)) return false;
+    int *offset = Fl_Window_Driver::menu_offset_y(win);
+    x = wl_fixed_to_double(sx) / scale + dx;
+    y = wl_fixed_to_double(sy) / scale + dy - (offset ? *offset : 0);
+    return true;
+  }
+};
+typedef std::shared_ptr<DomeTouchContact> DomeTouchPtr;
+struct DomeTouchPending { int action; DomeTouchPtr contact; double x, y; uint32_t time; };
+static Fl_Wayland_Touch_Handler dome_touch_handler = NULL;
+static void *dome_touch_user = NULL;
+static std::map<int32_t, DomeTouchPtr> dome_touch_contacts, dome_touch_delivered;
+static std::vector<DomeTouchPending> dome_touch_pending;
+static bool dome_touch_overflow = false;
+
+static void dome_touch_coords(Fl_Window *win, double x, double y) {
+  Fl::e_x = (int)x; Fl::e_y = (int)y;
+  Fl::e_x_root = Fl::e_x + win->x(); Fl::e_y_root = Fl::e_y + win->y();
+  Fl::e_dx = Fl::e_dy = 0;
+}
+static void dome_touch_cancel_contact(const DomeTouchPtr &contact) {
+  Fl_Window *win = contact->window();
+  if (!win) return;
+  if (contact->mode == 1) {
+    contact->handler(win, 3, contact->id, contact->x, contact->y, contact->primary, contact->user);
+  } else if (contact->mode == 2) {
+    // A cancellation must release a widget without activating it.
+    dome_touch_coords(win, -1000000, -1000000);
+    Fl::e_keysym = FL_Button + 1; Fl::e_is_click = 0;
+    // Buttons retain their pressed value until a drag leaves their bounds.
+    Fl::handle(FL_MOVE, win);
+    Fl::e_state &= ~FL_BUTTON1;
+    if (!contact->top.deleted()) Fl::handle(FL_RELEASE, win);
+  }
+}
+static void dome_touch_cancel_all() {
+  ++dome_touch_generation;
+  std::map<int32_t, DomeTouchPtr> delivered;
+  delivered.swap(dome_touch_delivered);
+  dome_touch_contacts.clear(); dome_touch_pending.clear();
+  for (const auto &entry : delivered) dome_touch_cancel_contact(entry.second);
+}
+static bool dome_touch_live(const DomeTouchPtr &contact) {
+  auto it = dome_touch_delivered.find(contact->id);
+  return it != dome_touch_delivered.end() && it->second == contact;
+}
+static void dome_touch_dispatch(const DomeTouchPending &event) {
+  const DomeTouchPtr contact = event.contact;
+  if (contact->generation != dome_touch_generation) return;
+  wld_event_time = event.time;
+  Fl_Window *win = contact->window();
+  if (!win) return;
+  contact->x = event.x; contact->y = event.y;
+  if (event.action == 0) {
+    if (!win->shown() || !win->visible_r()) return;
+    dome_touch_delivered[contact->id] = contact;
+    contact->mode = 1; // A callback can unregister itself reentrantly.
+    int handled = contact->handler(win, 0, contact->id, event.x, event.y, contact->primary, contact->user);
+    if (!dome_touch_live(contact) || contact->top.deleted()) return;
+    if (handled) return;
+    contact->mode = 3;
+    if (contact->primary && !(Fl::e_state & FL_BUTTON1)) {
+      contact->mode = 2;
+      dome_touch_coords(win, event.x, event.y);
+      Fl::e_state |= FL_BUTTON1; Fl::e_keysym = FL_Button + 1;
+      checkdouble(); Fl::handle(FL_PUSH, win);
+    }
+    return;
+  }
+  if (!dome_touch_live(contact)) return;
+  if (contact->mode == 1) {
+    contact->handler(win, event.action, contact->id, event.x, event.y, contact->primary, contact->user);
+  } else if (contact->mode == 2) {
+    dome_touch_coords(win, event.x, event.y);
+    Fl::e_keysym = FL_Button + 1;
+    if (event.action == 2) { Fl::e_state &= ~FL_BUTTON1; Fl::handle(FL_RELEASE, win); }
+    else { Fl::e_is_click = 0; Fl::handle(FL_MOVE, win); }
+  }
+  if (event.action == 2 && dome_touch_live(contact)) dome_touch_delivered.erase(contact->id);
+}
+static void dome_touch_queue(int action, const DomeTouchPtr &contact) {
+  if (dome_touch_pending.size() >= 2048) {
+    dome_touch_cancel_all(); dome_touch_overflow = true; return;
+  }
+  dome_touch_pending.push_back({action, contact, contact->x, contact->y, wld_event_time});
+}
+static void dome_touch_down(void *data, struct wl_touch *, uint32_t serial, uint32_t time,
+                            struct wl_surface *surface, int32_t id, wl_fixed_t x, wl_fixed_t y) {
+  if (!dome_touch_handler || dome_touch_overflow || dome_touch_contacts.size() >= 32) return;
+  Fl_Window *source = Fl_Wayland_Window_Driver::surface_to_window(surface);
+  if (!source || !source->shown()) return;
+  if (dome_touch_contacts.count(id)) { dome_touch_cancel_all(); return; }
+  auto contact = std::make_shared<DomeTouchContact>(id, dome_touch_contacts.empty(), source,
+      source->top_window(), dome_touch_handler, dome_touch_user);
+  if (!contact->position(x,y)) return;
+  dome_touch_contacts[id] = contact;
+  ((struct Fl_Wayland_Screen_Driver::seat*)data)->serial = serial;
+  wld_event_time = time;
+  dome_touch_queue(0, contact);
+}
+static void dome_touch_up(void *data, struct wl_touch *, uint32_t serial, uint32_t time, int32_t id) {
+  auto it = dome_touch_contacts.find(id);
+  if (it == dome_touch_contacts.end()) return;
+  const auto contact = it->second;
+  dome_touch_contacts.erase(it);
+  ((struct Fl_Wayland_Screen_Driver::seat*)data)->serial = serial;
+  wld_event_time = time;
+  dome_touch_queue(2, contact);
+}
+static void dome_touch_motion(void *, struct wl_touch *, uint32_t time, int32_t id, wl_fixed_t x, wl_fixed_t y) {
+  auto it = dome_touch_contacts.find(id);
+  if (it == dome_touch_contacts.end()) return;
+  const auto contact = it->second;
+  if (!contact->position(x,y)) { dome_touch_cancel_all(); return; }
+  wld_event_time = time;
+  dome_touch_queue(1, contact);
+}
+static void dome_touch_frame(void *, struct wl_touch *) {
+  std::vector<DomeTouchPending> pending;
+  pending.swap(dome_touch_pending);
+  dome_touch_overflow = false;
+  for (const auto &event : pending) dome_touch_dispatch(event);
+}
+static void dome_touch_cancel(void *, struct wl_touch *) { dome_touch_cancel_all(); }
+static struct wl_touch_listener dome_touch_listener = {
+  dome_touch_down, dome_touch_up, dome_touch_motion, dome_touch_frame, dome_touch_cancel, NULL, NULL
+};
+}
+extern "C" FL_EXPORT int fl_wl_set_touch_handler(Fl_Wayland_Touch_Handler handler, void *user) {
+  dome_touch_cancel_all(); dome_touch_handler = handler; dome_touch_user = user;
+  return Fl_Wayland_Screen_Driver::wl_display ? 1 : 0;
+}
 
