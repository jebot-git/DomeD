+// A nonblocking receive lets the source run even when both windows are FLTK
+// clients on the same connection. Track the widget across asynchronous delivery.
+struct PrimaryRead {
+  Fl_Widget_Tracker receiver;
+  std::vector<char> bytes;
+  explicit PrimaryRead(Fl_Widget &w) : receiver(&w) {}
+};
+static void primary_read(FL_SOCKET fd, void *opaque) {
+  PrimaryRead *transfer = (PrimaryRead *)opaque;
+  char chunk[16384];
+  bool failed = false;
+  for (;;) {
+    ssize_t n = read(fd, chunk, sizeof chunk);
+    if (n < 0 && errno == EINTR) continue;
+    if (n < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) return;
+    if (n <= 0) { failed = n < 0; break; }
+    if (transfer->bytes.size() + n > 64 * 1024 * 1024) { failed = true; break; }
+    transfer->bytes.insert(transfer->bytes.end(), chunk, chunk + n);
+  }
+  Fl::remove_fd(fd); close(fd);
+  if (!failed && transfer->receiver.exists()) {
+    transfer->bytes.push_back(0);
+    Fl::e_text = transfer->bytes.data();
+    Fl::e_length = transfer->bytes.size() - 1;
+    Fl::e_clipboard_type = Fl::clipboard_plain_text;
+    int previous = Fl::e_number;
+    transfer->receiver.widget()->handle(Fl::e_number = FL_PASTE);
+    Fl::e_number = previous;
+    Fl::e_text = (char *)""; Fl::e_length = 0;
+  }
+  delete transfer;
+}
 
