+// A destination can disappear during a large transfer. Do not let its closed
+// pipe terminate the application, and preserve the caller's signal disposition.
+static ssize_t selection_write(int fd, const char *bytes, size_t count) {
+  sigset_t blocked, previous, pending;
+  sigemptyset(&blocked); sigaddset(&blocked, SIGPIPE);
+  pthread_sigmask(SIG_BLOCK, &blocked, &previous);
+  sigpending(&pending);
+  ssize_t n = write(fd, bytes, count);
+  int saved_errno = errno;
+  if (n < 0 && saved_errno == EPIPE && !sigismember(&pending, SIGPIPE)) {
+    struct timespec zero = {0, 0};
+    while (sigtimedwait(&blocked, NULL, &zero) < 0 && errno == EINTR) {}
+  }
+  pthread_sigmask(SIG_SETMASK, &previous, NULL);
+  errno = saved_errno;
+  return n;
+}
