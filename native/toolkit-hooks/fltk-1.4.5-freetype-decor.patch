+// The bundled libdecor plugin uses the same bitmap face as FLTK controls.
+static FT_Face fl_bdf_title_face() {
+  const char *pixels=getenv("DE_XR_BDF_PIXELS");
+  Fl_Font font=(pixels || getenv("DE_XR_LIGHTXR_PCF")) ? FL_FREE_FONT : FL_HELVETICA;
+  return dome_bitmap(font,pixels ? atoi(pixels) : 16);
+}
+extern "C" void fl_bdf_title_metrics(const char *text,int *width,int *height,int *ascent) {
+  *width=*height=*ascent=0;
+  if(auto face=fl_bdf_title_face()){
+    *width=dome_bitmap_width(face,text,strlen(text));
+    *ascent=face->size->metrics.ascender/64;
+    *height=std::max(int(face->size->metrics.height/64),*ascent-int(face->size->metrics.descender/64));
+  }
+}
+extern "C" int fl_bdf_title_height() {
+  int width,height,ascent;fl_bdf_title_metrics("",&width,&height,&ascent);return std::max(24,height+8);
+}
+extern "C" void fl_bdf_title_draw(cairo_t *cr,const char *text,double x,double baseline) {
+  if(auto face=fl_bdf_title_face())dome_bitmap_draw(cr,face,text,strlen(text),x,baseline);
+}
+
 int Fl_Cairo_Graphics_Driver::height() {
   if(auto face=dome_bitmap(font(),size())){int h=face->size->metrics.height/64,b=(face->size->metrics.ascender-face->size->metrics.descender)/64;return h>b?h:b;}
   return 0;
