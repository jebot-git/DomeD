 #include <set>
 #include <string>
 #include <vector>
+// Fontconfig treats multiple fontformat values as an intersection. Query
+// each native bitmap format separately, then merge the resulting patterns.
+static FcFontSet *dome_bitmap_list(FcPattern *filter, FcObjectSet *objects) {
+  auto result = FcFontSetCreate();
+  if (!result) return nullptr;
+  for (const char *format : {"BDF", "PCF"}) {
+    if (getenv("DE_XR_LIGHTXR_PCF") && !strcmp(format, "BDF")) continue;
+    auto query = FcPatternDuplicate(filter);
+    if (!query) { FcFontSetDestroy(result); return nullptr; }
+    FcPatternDel(query, FC_FONTFORMAT);
+    FcPatternAddString(query, FC_FONTFORMAT, (const FcChar8 *)format);
+    auto fonts = FcFontList(nullptr, query, objects); FcPatternDestroy(query);
+    if (!fonts) continue;
+    for (int i = 0; i < fonts->nfont; ++i) {
+      auto copy = FcPatternDuplicate(fonts->fonts[i]);
+      if (!copy || !FcFontSetAdd(result, copy)) {
+        if (copy) FcPatternDestroy(copy);
+        FcFontSetDestroy(fonts); FcFontSetDestroy(result); return nullptr;
+      }
+    }
+    FcFontSetDestroy(fonts);
+  }
+  return result;
+}
