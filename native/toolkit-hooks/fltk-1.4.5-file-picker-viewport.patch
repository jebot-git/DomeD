+// Responsive shared chooser; distributed under FLTK's COPYING terms.
+#include "Fl_File_Chooser_Viewport.H"
+#include <FL/Fl.H>
+#include <FL/Fl_Button.H>
+#include <FL/Fl_Check_Button.H>
+#include <FL/Fl_Choice.H>
+#include <FL/Fl_File_Browser.H>
+#include <FL/Fl_File_Input.H>
+#include <FL/Fl_Menu_Button.H>
+#include <FL/Fl_Return_Button.H>
+#include <FL/Fl_Box.H>
+#include <FL/Fl_Scroll.H>
+#include <FL/fl_draw.H>
+#include <algorithm>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+namespace {
+int text_width(Fl_Widget *w,const char *text) {
+  Fl_Font saved=fl_font();Fl_Fontsize size=fl_size();
+  fl_font(w->labelfont(),w->labelsize());int n=int(fl_width(text?text:""));fl_font(saved,size);return n;
+}
+int button_width(Fl_Widget *w){return text_width(w,w->label())+28;}
+void style(Fl_Widget *to,Fl_Widget *from) {
+  to->labelfont(from->labelfont());to->labelsize(from->labelsize());
+  to->labelcolor(from->labelcolor());to->color(from->color());to->selection_color(from->selection_color());
+  if(Fl_Menu_ *menu=dynamic_cast<Fl_Menu_ *>(to)){menu->textfont(from->labelfont());menu->textsize(from->labelsize());menu->textcolor(from->labelcolor());}
+}
+struct Area {int x,y,w,h;};
+Area work_area(Fl_Window *w) {
+  Area a;int screen=Fl::screen_num(w->x(),w->y(),std::max(1,w->w()),std::max(1,w->h()));
+  Fl::screen_work_area(a.x,a.y,a.w,a.h,screen);
+  // Reserve native title decoration as well as a small outer margin. FLTK uses
+  // logical client coordinates, including on scaled Wayland outputs.
+  int inset=std::min(8,std::max(0,std::min(a.w,a.h)/20));
+  a.x+=inset;a.y+=inset+std::min(32,std::max(0,a.h/8));
+  a.w=std::max(1,a.w-2*inset);a.h=std::max(1,a.h-2*inset-std::min(32,std::max(0,a.h/8)));
+  return a;
+}
+class ViewWindow:public Fl_Double_Window {
+  bool initial_;
+protected:
+  bool laying_;
+  void constrain(bool initial=false) {
+    Area a=work_area(this);int W=std::min(w(),a.w),H=std::min(h(),a.h);
+    int X=std::max(a.x,std::min(x(),a.x+a.w-W)),Y=std::max(a.y,std::min(y(),a.y+a.h-H));
+    if(initial){X=a.x+(a.w-W)/2;Y=a.y+(a.h-H)/2;}
+    size_range(std::min(320,a.w),std::min(220,a.h),a.w,a.h);
+    if(X!=x()||Y!=y()||W!=w()||H!=h())resize(X,Y,W,H);
+  }
+public:
+  ViewWindow(int X,int Y,int W,int H,const char *name):Fl_Double_Window(X,Y,W,H,name),initial_(true),laying_(false){end();}
+  void show() FL_OVERRIDE {constrain(initial_);initial_=false;Fl_Double_Window::show();}
+  void resize(int X,int Y,int W,int H) FL_OVERRIDE {Area a=work_area(this);W=std::min(W,a.w);H=std::min(H,a.h);X=std::max(a.x,std::min(X,a.x+a.w-W));Y=std::max(a.y,std::min(Y,a.y+a.h-H));Fl_Double_Window::resize(X,Y,std::max(1,W),std::max(1,H));}
+};
+class PlacesWindow:public ViewWindow {
+  Fl_Group *places_,*home_;Fl_Window *owner_;Fl_Widget *font_;Fl_Button close_;
+public:
+  PlacesWindow(Fl_Group *places,Fl_Group *home,Fl_Widget *font,Fl_Window *owner):ViewWindow(0,0,560,480,"Locations"),places_(places),home_(home),owner_(owner),font_(font),close_(0,0,100,30,"Close"){
+    add(close_);style(&close_,font);close_.callback([](Fl_Widget *,void *data){static_cast<PlacesWindow *>(data)->hide();},this);
+    callback([](Fl_Widget *w,void *){w->hide();});set_modal();end();
+  }
+  ~PlacesWindow(){if(places_->parent()==this){remove(places_);home_->add(places_);places_->hide();}}
+  void show() FL_OVERRIDE {add(places_);places_->show();layout();ViewWindow::show();}
+  void hide() FL_OVERRIDE {Fl_Double_Window::hide();if(places_->parent()==this){remove(places_);home_->add(places_);places_->hide();}if(home_->window())home_->window()->redraw();}
+  void finish_navigation(){hide();if(owner_&&owner_->shown())owner_->hide();}
+  void layout(){style(&close_,font_);int g=8,h=std::max(28,close_.labelsize()+14);places_->resize(g,g,std::max(1,w()-2*g),std::max(1,this->h()-h-3*g));close_.resize(w()-button_width(&close_)-g,this->h()-h-g,button_width(&close_),h);}
+  void resize(int X,int Y,int W,int H) FL_OVERRIDE {ViewWindow::resize(X,Y,W,H);if(!laying_){laying_=true;layout();laying_=false;}}
+  void draw() FL_OVERRIDE {layout();Fl_Double_Window::draw();}
+};
+class OptionsWindow:public ViewWindow {
+  struct Link {Fl_Widget *original,*proxy;OptionsWindow *owner;};
+  std::vector<std::unique_ptr<Link> > links_;
+  Fl_Scroll scroll_;Fl_Button locations_,close_;
+  Fl_Chooser_Viewport_Controls c_;
+  std::unique_ptr<PlacesWindow> places_;
+  static void changed(Fl_Widget *,void *data) {
+    Link &l=*static_cast<Link *>(data);
+    if(Fl_Choice *choice=dynamic_cast<Fl_Choice *>(l.original))choice->value(static_cast<Fl_Choice *>(l.proxy)->value());
+    else if(Fl_Check_Button *check=dynamic_cast<Fl_Check_Button *>(l.original))check->value(static_cast<Fl_Check_Button *>(l.proxy)->value());
+    else if(Fl_Menu_Button *menu=dynamic_cast<Fl_Menu_Button *>(l.original))menu->value(static_cast<Fl_Menu_Button *>(l.proxy)->value());
+    l.original->do_callback();l.owner->sync();if(l.original->window())l.original->window()->redraw();
+  }
+public:
+  OptionsWindow(const Fl_Chooser_Viewport_Controls &c):ViewWindow(0,0,620,520,"File chooser options"),scroll_(8,8,604,450),locations_(0,0,200,30,"Locations…"),close_(0,0,100,30,"Close"),c_(c){
+    scroll_.end();add(scroll_);scroll_.add(locations_);scroll_.type(Fl_Scroll::VERTICAL_ALWAYS);
+    locations_.callback([](Fl_Widget *,void *data){OptionsWindow *p=static_cast<OptionsWindow *>(data);if(!p->places_)p->places_.reset(new PlacesWindow(p->c_.places,p->c_.panel,p->c_.files,p));p->places_->show();},this);
+    style(&locations_,c.files);add(close_);style(&close_,c.files);close_.callback([](Fl_Widget *,void *data){static_cast<OptionsWindow *>(data)->hide();},this);
+    callback([](Fl_Widget *w,void *){w->hide();});set_modal();
+    Fl_Widget *items[11];for(int i=0;i<6;++i)items[i]=c.tools[i];items[6]=c.preview_toggle;items[7]=c.hidden;items[8]=c.filter;items[9]=c.favorites;items[10]=c.new_directory;
+    for(int i=0;i<11;++i){
+      Fl_Widget *original=items[i],*proxy;
+      if(Fl_Choice *choice=dynamic_cast<Fl_Choice *>(original)){Fl_Choice *p=new Fl_Choice(0,0,200,30);p->copy(choice->menu());proxy=p;}
+      else if(Fl_Menu_Button *menu=dynamic_cast<Fl_Menu_Button *>(original)){Fl_Menu_Button *p=new Fl_Menu_Button(0,0,200,30);p->copy(menu->menu());proxy=p;}
+      else if(dynamic_cast<Fl_Check_Button *>(original))proxy=new Fl_Check_Button(0,0,200,30);
+      else proxy=new Fl_Button(0,0,200,30);
+      proxy->copy_label(i==0?"Sort by:":(i==10?"New folder…":(original->label()?original->label():"")));proxy->tooltip(original->tooltip());style(proxy,original);scroll_.add(proxy);
+      std::unique_ptr<Link> link(new Link{original,proxy,this});proxy->callback(changed,link.get());links_.push_back(std::move(link));
+    }
+    end();sync();
+  }
