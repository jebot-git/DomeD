+// Clipboard commands may be dispatched by a native menu timer without a new
+// input event. Obtain an actual server timestamp, and never consume another
+// transfer's events while synchronously querying clipboard metadata.
+struct Fl_Clipboard_Query {
+  Window requestor;
+  Atom property;
+  Time time;
+  unsigned long serial;
+};
+static Bool clipboard_clock_event(Display *, XEvent *event, XPointer data) {
+  const Fl_Clipboard_Query &q = *reinterpret_cast<Fl_Clipboard_Query *>(data);
+  return event->type == PropertyNotify && event->xproperty.window == q.requestor &&
+         event->xproperty.atom == q.property && event->xproperty.state == PropertyNewValue &&
+         event->xproperty.serial >= q.serial;
+}
+static Bool clipboard_targets_event(Display *, XEvent *event, XPointer data) {
+  const Fl_Clipboard_Query &q = *reinterpret_cast<Fl_Clipboard_Query *>(data);
+  return event->type == SelectionNotify && event->xselection.requestor == q.requestor &&
+         event->xselection.selection == CLIPBOARD && event->xselection.target == TARGETS &&
+         event->xselection.time == q.time &&
+         (event->xselection.property == q.property || event->xselection.property == None);
+}
+static bool clipboard_wait_event(XEvent &event, Bool (*matches)(Display *, XEvent *, XPointer),
+                                 Fl_Clipboard_Query &query) {
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(250);
+  XFlush(fl_display);
+  for (;;) {
+    if (XCheckIfEvent(fl_display, &event, matches, reinterpret_cast<XPointer>(&query))) return true;
+    const auto left = std::chrono::duration_cast<std::chrono::microseconds>(
+      deadline - std::chrono::steady_clock::now()).count();
+    if (left <= 0) return false;
+#if USE_POLL
+    pollfd input = {ConnectionNumber(fl_display), POLLIN, 0};
+    int ready = poll(&input, 1, static_cast<int>((left + 999) / 1000));
+    if (ready > 0 && (input.revents & (POLLERR | POLLHUP | POLLNVAL))) return false;
+#else
+    const int fd = ConnectionNumber(fl_display);
+    if (fd < 0 || fd >= FD_SETSIZE) return false;
+    fd_set input; FD_ZERO(&input); FD_SET(fd, &input);
+    timeval timeout; timeout.tv_sec = 0; timeout.tv_usec = static_cast<long>(left);
+    int ready = select(fd + 1, &input, NULL, NULL, &timeout);
+#endif
+    if (ready == 0 || (ready < 0 && errno != EINTR)) return false;
+  }
+}
+static bool clipboard_server_time(Time &time) {
+  if (!fl_display || !fl_message_window) return false;
+  XWindowAttributes attributes;
+  if (!XGetWindowAttributes(fl_display, fl_message_window, &attributes)) return false;
+  XSelectInput(fl_display, fl_message_window, attributes.your_event_mask | PropertyChangeMask);
+  Fl_Clipboard_Query query = {fl_message_window, FLTK_CLIPBOARD_CLOCK, 0, NextRequest(fl_display)};
+  const unsigned char value = 0;
+  XChangeProperty(fl_display, query.requestor, query.property, XA_INTEGER, 8,
+                  PropModeReplace, &value, 1);
+  XEvent event;
+  const bool received = clipboard_wait_event(event, clipboard_clock_event, query);
+  XSelectInput(fl_display, fl_message_window, attributes.your_event_mask);
+  if (received) time = event.xproperty.time;
+  return received;
+}
