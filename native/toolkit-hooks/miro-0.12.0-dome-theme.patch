diff --git a/src/dome_appearance.rs b/src/dome_appearance.rs
new file mode 100644
index 0000000..7748376
--- /dev/null
+++ b/src/dome_appearance.rs
@@ -0,0 +1,27 @@
+//! Follow DomeD's standard desktop Settings portal without rewriting Miro preferences.
+use iced::{Subscription, Task};
+
+use crate::app::AppMessage;
+
+fn enabled() -> bool {
+    std::env::var("XDG_CURRENT_DESKTOP")
+        .unwrap_or_default()
+        .split(':')
+        .any(|desktop| desktop.eq_ignore_ascii_case("Dome"))
+}
+
+pub fn startup() -> Task<AppMessage> {
+    if enabled() {
+        iced::system::theme().map(AppMessage::DomeAppearance)
+    } else {
+        Task::none()
+    }
+}
+
+pub fn subscription() -> Subscription<AppMessage> {
+    if enabled() {
+        iced::system::theme_changes().map(AppMessage::DomeAppearance)
+    } else {
+        Subscription::none()
+    }
+}
