+// A Wayland popup_done must finish the modal menu loop, not merely hide its
+// windows: the loop otherwise maps every hidden menu again on its next tick.
+void Fl_Window_Driver::dismiss_menu() {
+  if (menuwindow::parent_ && p) {
+    p->current_item = NULL;
+    p->state = DONE_STATE;
+  }
+}
 
