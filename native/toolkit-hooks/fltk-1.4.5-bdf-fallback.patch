+// Missing glyphs use another native BDF strike, never an outline font.
+static FT_Face dome_bitmap_glyph(FT_Face primary, unsigned cp) {
+  if (FT_Get_Char_Index(primary, cp) || getenv("DE_XR_LIGHTXR_PCF")) return primary;
+  static FT_Library library = nullptr;
+  static FcConfig *configuration = nullptr;
+  static std::map<std::pair<FT_Face,unsigned>,FT_Face> glyphs;
+  static std::map<std::string,FT_Face> faces;
+  if (configuration != FcConfigGetCurrent()) {
+    for (auto &entry : faces) if (entry.second) FT_Done_Face(entry.second);
+    faces.clear(); glyphs.clear(); configuration = FcConfigGetCurrent();
+  }
+  auto key = std::make_pair(primary, cp);
+  auto cached = glyphs.find(key);
+  if (cached != glyphs.end()) return cached->second ? cached->second : primary;
+  auto charset = FcCharSetCreate(); FcCharSetAddChar(charset, cp);
+  auto filter = FcPatternCreate();
+  FcPatternAddString(filter, FC_FONTFORMAT, (const FcChar8 *)"BDF");
+  FcPatternAddCharSet(filter, FC_CHARSET, charset); FcCharSetDestroy(charset);
+  auto objects = FcObjectSetBuild(FC_FILE, FC_FAMILY, FC_PIXEL_SIZE, FC_FONTFORMAT, nullptr);
+  auto available = FcFontList(nullptr, filter, objects);
+  FcPatternDestroy(filter); FcObjectSetDestroy(objects);
+  auto query = FcPatternCreate();
+  int pixels = primary->size->metrics.y_ppem;
+  FcPatternAddDouble(query, FC_PIXEL_SIZE, pixels);
+  FcDefaultSubstitute(query);
+  FcResult result;
+  auto match = available ? FcFontSetMatch(nullptr, &available, 1, query, &result) : nullptr;
+  FcPatternDestroy(query);
+  FT_Face face = nullptr; FcChar8 *file = nullptr;
+  if (match && FcPatternGetString(match, FC_FILE, 0, &file) == FcResultMatch) {
+    auto name = std::string((const char *)file) + ":" + std::to_string(pixels);
+    auto loaded = faces.find(name);
+    if (loaded != faces.end()) face = loaded->second;
+    else {
+      if (!library) FT_Init_FreeType(&library);
+      if (library && !FT_New_Face(library, (const char *)file, 0, &face)) {
+        bool valid = !FT_IS_SCALABLE(face) && face->num_fixed_sizes &&
+          FT_Get_Font_Format(face) && !strcmp(FT_Get_Font_Format(face), "BDF") &&
+          !FT_Select_Charmap(face, FT_ENCODING_UNICODE);
+        int best = 0;
+        for (int i = 1; i < face->num_fixed_sizes; ++i)
+          if (abs(int(face->available_sizes[i].y_ppem/64)-pixels) <
+              abs(int(face->available_sizes[best].y_ppem/64)-pixels)) best = i;
+        if (!valid || FT_Select_Size(face, best)) { FT_Done_Face(face); face = nullptr; }
+      }
+      faces[name] = face;
+    }
+    if (face && !FT_Get_Char_Index(face, cp)) face = nullptr;
+  }
+  if (match) FcPatternDestroy(match);
+  if (available) FcFontSetDestroy(available);
+  glyphs[key] = face;
+  return face ? face : primary;
+}
