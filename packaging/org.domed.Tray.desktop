[Desktop Entry]
Type=Application
NoDisplay=true
Name=DomeD Tray Applications
Comment=Manage tray applications, translation, screenshots, input methods and wallets
Exec=dome-tray --tray
TryExec=dome-tray
Icon=org.domed.Tray
Terminal=false
Categories=Utility;
Keywords=tray;translator;screenshot;input;wallet;devices;
StartupWMClass=org.domed.Tray
