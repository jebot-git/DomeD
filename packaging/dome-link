#!/usr/bin/python3
"""Launch a link handler in the active realm of the caller's DomeD session."""
import argparse
import json
import os
from pathlib import Path
import socket
import stat
import struct
import urllib.request


def identity(path):
    with socket.socket(socket.AF_UNIX) as connection:
        connection.settimeout(.5)
        connection.connect(str(path))
        pid, uid, _ = struct.unpack('3i', connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
    executable = os.readlink(f'/proc/{pid}/exe').removesuffix(' (deleted)')
    if uid != os.getuid() or Path(executable).name != 'dome-compositor':
        raise ValueError('Not this user’s DomeD socket')
    return pid


def record(path, pid):
    source = Path(str(path) + '.dome-session.json')
    info = source.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o022 or info.st_size > 4096:
        raise ValueError('Invalid session record')
    value = json.loads(source.read_text())
    if value.get('version') != 1 or value.get('compositor_pid') != pid:
        raise ValueError('Stale session record')
    return value


def prepare(app_id=None, requested="auto"):
    """Fail back to the caller's display outside a verified DomeD session."""
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', '/nonexistent'))
    display = os.environ.get('WAYLAND_DISPLAY')
    if not display:
        return
    path = Path(display) if Path(display).is_absolute() else runtime / display
    try:
        pid = identity(path)
        context = record(path, pid)
        port = context.get('control_port')
        if type(port) is not int or not 1 <= port <= 65535:
            return
        http = urllib.request.build_opener(urllib.request.ProxyHandler({}))

        def request(route, data=None):
            payload = None if data is None else json.dumps(data).encode()
            with http.open(urllib.request.Request(f'http://127.0.0.1:{port}' + route,
                    data=payload, headers={'Content-Type': 'application/json'}), timeout=1) as response:
                return json.loads(response.read(4 * 1024 * 1024 + 1))

        if requested == 'caller':
            realm = context.get('realm')
        elif requested == 'auto':
            realm = request('/api/xr-control').get('input_realm')
        else:
            realm = requested
        if realm not in ('desktop', 'xr'):
            return
        target = None
        # Look only within this compositor; another login's sockets are ineligible.
        for candidate in sorted(runtime.glob('*.dome-session.json'))[:128]:
            socket_path = Path(str(candidate).removesuffix('.dome-session.json'))
            try:
                value = record(socket_path, pid)
                if value.get('realm') == realm and identity(socket_path) == pid:
                    target = socket_path
                    break
            except (OSError, ValueError):
                continue
        if target is None:
            return
        os.environ['WAYLAND_DISPLAY'] = str(target)
        os.environ.pop('WAYLAND_SOCKET', None)
        if app_id:
            # A single-instance handler may keep its original Wayland connection.
            # Present that existing window in the requested realm before forwarding
            # its URL over D-Bus; do not create a competing browser profile.
            scene = request('/api/state')['scene']
            popups = {p['id'] for p in scene.get('popups', [])}
            for window in scene['windows']:
                if window.get('app_id') == app_id and window['id'] not in popups:
                    request('/api/action', {'op': 'window_visibility', 'id': window['id'],
                        'desktop': realm == 'desktop', 'xr': realm == 'xr'})
                    request('/api/action', {'op': 'focus', 'id': window['id']})
    except (OSError, ValueError, KeyError, TypeError):
        return


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--realm', choices=['auto','caller','desktop','xr'], default='auto',
        help='auto follows input ownership; caller preserves the verified launching socket')
    parser.add_argument('--app-id', help='Present an existing single-instance window in this realm')
    parser.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ['--'] else args.command
    if not command:
        parser.error('a handler command is required after --')
    prepare(args.app_id, args.realm)
    os.execvp(command[0], command)


if __name__ == '__main__':
    main()
