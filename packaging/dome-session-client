#!/usr/bin/python3
"""Keep Dome's children in a private process group and stop them on logout."""
import os
import signal
import subprocess
import sys
import time

child = None


def terminate(_signum, _frame):
    if child is not None:
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass


for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
    signal.signal(sig, terminate)

args = ["/usr/local/bin/dome-compositor", "--backend", "drm"]
if os.environ.get("DOME_SESSION_TERMINAL", "1") != "0":
    args.append("--terminal")
try:
    if os.environ.get("DOME_LOGIN_SESSION") == "1":
        # Refresh generated XDG entries before the compositor publishes its
        # ready display and starts dome-session.target. The user manager can
        # survive logout while applications change their login preferences.
        status = subprocess.run(["systemctl", "--user", "daemon-reload"], check=False)
        if status.returncode:
            print("Could not refresh login applications", file=sys.stderr, flush=True)
    child = subprocess.Popen(args, start_new_session=True)
    print(f"DomeD compositor PID: {child.pid}", flush=True)
    result = child.wait()
finally:
    # Only a real Dome login owns this target; nested/test sessions never do.
    subprocess.run(["systemctl", "--user", "stop", "dome-session.target"], check=False)
    if child is not None:
        terminate(None, None)
        deadline = time.monotonic() + 3
        while time.monotonic() < deadline:
            try:
                os.killpg(child.pid, 0)
            except ProcessLookupError:
                break
            time.sleep(0.05)
        else:
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
sys.exit(result if result >= 0 else 128 - result)
